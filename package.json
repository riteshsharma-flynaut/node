{
    "name": "nodejs-project-structure",
    "version": "1.0.0",
    "main": "server.ts",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "nodemon",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "prisma:deploy": "prisma migrate deploy",
        "logs:clear-linux": "rm -rf logs/*.log",
        "logs:clear-windows": "del logs\\*.log",
        "logs:clear": "npm run logs:clear-linux || npm run logs:clear-windows",
        "health": "curl -f http://localhost:3000/health || exit 1",
        "prettier:check": "prettier --check 'src/**/*.{ts,js,json}'",
        "prettier:write": "prettier --write 'src/**/*.{ts,js,json}'",
        "prettier:format": "npm run prettier:check && npm run prettier:write"
    },
    "author": "Ritesh sharma",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@prisma/client": "^6.9.0",
        "@prisma/extension-accelerate": "^2.0.1",
        "bcryptjs": "^3.0.2",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^5.1.0",
        "express-rate-limit": "^7.5.0",
        "express-validator": "^7.2.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "prisma": "^6.9.0",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.18",
        "@types/express": "^5.0.2",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.15.29",
        "nodemon": "^3.1.10",
        "prettier": "^3.5.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
}